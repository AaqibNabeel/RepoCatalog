---
import { ICONS } from './icons.js';
import categories from '../data/categories.json';

interface Props {
  activeSlug?: string | null;
}
const { activeSlug = null } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="tabs" id="category-tabs">
  <a
    class:list={['tab', { active: !activeSlug }]}
    href={`${base}/`}
  >
    all
  </a>

  {categories.map((cat) => (
  <a
    class:list={['tab', { active: activeSlug === cat.slug }]}
    href={`${base}/category/${cat.slug}/`}
  >
    <svg
      width="10"
      height="10"
      viewBox="0 0 16 16"
      fill="currentColor"
      style={`color:${cat.color}`}
    >
      <path d="M9.5 3.25a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.493 2.493 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25zM4.25 12a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zM3.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0zm8.5-.75a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5z" />
    </svg>
    {cat.label}
  </a>
))}
</div>

<style>
  .tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 12px 0 20px;
    scrollbar-width: thin;
  }
  .tab {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: var(--card);
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .tab:hover { border-color: var(--ink-soft); }
  .tab.active { color: var(--ink); border-color: var(--ink); font-weight: 500; }
</style>
